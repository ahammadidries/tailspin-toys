---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div class="mb-8 max-w-xl">
      <form role="search" aria-label="Search games by title" data-testid="game-search-form" class="space-y-3">
        <label for="game-search-input" class="block text-sm font-medium text-slate-200">Search games by title</label>
        <div class="relative">
          <input
            id="game-search-input"
            name="q"
            type="search"
            aria-controls="games-grid"
            placeholder="Search by title..."
            autocomplete="off"
            data-testid="game-search-input"
            class="w-full rounded-xl border border-slate-600 bg-slate-900/60 px-4 py-3 pr-24 text-slate-100 placeholder:text-slate-400 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500"
          />
          <button
            type="submit"
            data-testid="game-search-submit"
            class="absolute inset-y-2 right-2 rounded-lg bg-blue-600 px-3 py-1.5 text-sm font-medium text-white transition-colors duration-200 hover:bg-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500"
          >
            Search
          </button>
        </div>
      </form>
    </div>

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid" id="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>

          <div class="hidden" data-testid="search-empty-state" id="search-empty-state">
            <EmptyState text="No games match your search." />
          </div>
        </>
      )}
    </div>
  </div>

  <script>
    const searchForm = document.querySelector('[data-testid="game-search-form"]');
    const searchInput = document.querySelector('[data-testid="game-search-input"]');
    const gamesGrid = document.querySelector('[data-testid="games-grid"]');
    const emptyState = document.querySelector('[data-testid="search-empty-state"]');
    const gameCards = Array.from(document.querySelectorAll('[data-game-title]'));

    const applySearchFilter = () => {
      if (!(searchInput instanceof HTMLInputElement) || !(gamesGrid instanceof HTMLElement) || !(emptyState instanceof HTMLElement)) {
        return;
      }

      const query = searchInput.value.trim().toLowerCase();
      let visibleCards = 0;

      gameCards.forEach((card) => {
        const title = (card.getAttribute('data-game-title') ?? '').toLowerCase();
        const matches = title.includes(query);
        card.classList.toggle('hidden', !matches);
        if (matches) {
          visibleCards += 1;
        }
      });

      gamesGrid.classList.toggle('hidden', visibleCards === 0);
      emptyState.classList.toggle('hidden', visibleCards !== 0);
    };

    searchInput?.addEventListener('input', applySearchFilter);
    searchForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      applySearchFilter();
      if (searchInput instanceof HTMLInputElement) {
        searchInput.blur();
      }
    });

    applySearchFilter();
  </script>
</Layout>
